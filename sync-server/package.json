{
  "name": "kasirgratisan-sync",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Sync server offline-first FreeKasir di Cloudflare Workers + D1",
  "scripts": {
    "deploy": "wrangler deploy",
    "dry-run": "wrangler deploy --dry-run",
    "db:init": "wrangler d1 execute freekasir-sync --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute freekasir-sync --local --file=./schema.sql",
    "secret": "wrangler secret put SYNC_SECRET",
    "dev": "wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250726.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.28.0"
  }
}
