{
	// Worker sync untuk FreeKasir. Terpisah total dari worker frontend di root repo.
	"$schema": "https://json.schemastore.org/wrangler.json",
	"name": "kasirgratisan-sync",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-01",
	"observability": {
		"enabled": true
	},
	// Worker ini memegang data toko. URL utamanya memang perlu publik supaya HP
	// kalian bisa menghubunginya, tapi URL preview per-versi tidak ada gunanya
	// di sini dan cuma menambah pintu masuk — dimatikan.
	"workers_dev": true,
	"preview_urls": false,
	// Kode Worker membaca binding bernama `DB` (lihat `Env` di src/index.ts),
	// jadi namanya harus persis itu. `wrangler d1 create` sempat menambahkan
	// binding kedua bernama `freekasir_sync` ke database yang sama — sudah
	// dihapus supaya tidak ada dua binding untuk satu database.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "freekasir-sync",
			"database_id": "36be8cc3-04b8-41d0-99c6-87d95aa4d8f3"
		}
	]
	// SYNC_SECRET TIDAK ditulis di sini. Set lewat:
	//   npx wrangler secret put SYNC_SECRET
}