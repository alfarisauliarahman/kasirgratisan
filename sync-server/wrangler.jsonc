{
  // Worker sync untuk FreeKasir. Terpisah total dari worker frontend di root repo.
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "kasirgratisan-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "freekasir-sync",
      // Ganti dengan database_id asli dari output `wrangler d1 create freekasir-sync`.
      "database_id": "<PASTE_DATABASE_ID>"
    }
  ]
  // SYNC_SECRET TIDAK ditulis di sini. Set lewat:
  //   npx wrangler secret put SYNC_SECRET
}
